// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  STUDENT
  INSTRUCTOR
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ExerciseType {
  READING
  LISTENING
  WRITING
  FILL_IN_BLANK
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  status                  AccountStatus            @default(ACTIVE)
  emailVerified           Boolean                  @default(false) @map("email_verified")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")

  profile                 UserProfile?
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  notificationPreference  NotificationPreference?
  quizAttempts            QuizAttempt[]
  lessonProgress          LessonProgress[]
  bookmarks               UserBookmark[]
  savedJobs               SavedJob[]
  jobApplications         JobApplication[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleType   @unique
  description String?

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  firstName             String?  @map("first_name")
  lastName              String?  @map("last_name")
  preferredLanguage     String   @default("en") @map("preferred_language")
  targetAusbildungField String?  @map("target_ausbildung_field")
  phoneNumber           String?  @map("phone_number")
  avatarUrl             String?  @map("avatar_url")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  clientIp   String?  @map("client_ip")
  userAgent  String?  @map("user_agent")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  jobAlerts          Boolean  @default(true) @map("job_alerts")
  speakingInvites    Boolean  @default(true) @map("speaking_invites")
  marketing          Boolean  @default(false)
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// German Learning Curriculum Entities (Phase 3)
// -----------------------------------------------------------------------------

model LearningLevel {
  id            String          @id @default(uuid())
  code          CefrLevel       @unique
  title         String
  description   String?
  sequenceOrder Int             @map("sequence_order")

  modules       LearningModule[]

  @@map("learning_levels")
}

model LearningModule {
  id            String        @id @default(uuid())
  levelId       String        @map("level_id")
  title         String
  description   String?
  sequenceOrder Int           @map("sequence_order")

  level         LearningLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@index([levelId])
  @@map("learning_modules")
}

model Lesson {
  id               String               @id @default(uuid())
  moduleId         String               @map("module_id")
  slug             String               @unique
  titleDe          String               @map("title_de")
  grammarNotesDe   String?              @map("grammar_notes_de")
  estimatedMinutes Int                  @default(15) @map("estimated_minutes")
  sequenceOrder    Int                  @map("sequence_order")
  coinReward       Int                  @default(10) @map("coin_reward")

  module           LearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  translations     LessonTranslation[]
  vocabulary       VocabularyItem[]
  exercises        Exercise[]
  quizQuestions    QuizQuestion[]
  progress         LessonProgress[]
  bookmarks        UserBookmark[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonTranslation {
  id            String   @id @default(uuid())
  lessonId      String   @map("lesson_id")
  languageCode  String   @map("language_code") // "bn", "en", "de"
  title         String
  summary       String?
  grammarNotes  String?  @map("grammar_notes") // Bengali/English explanation of German grammar rule
  content       Json?

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, languageCode])
  @@map("lesson_translations")
}

model VocabularyItem {
  id                         String         @id @default(uuid())
  lessonId                   String?        @map("lesson_id")
  word                       String
  article                    String?        // "der", "die", "das", or null
  pluralForm                 String?        @map("plural_form")
  ipaPronunciation           String?        @map("ipa_pronunciation")
  audioUrl                   String?        @map("audio_url")
  partOfSpeech               String?        @map("part_of_speech")
  translations               Json           // { "bn": "...", "en": "..." }
  exampleSentenceDe          String?        @map("example_sentence_de")
  exampleSentenceTranslation Json?          @map("example_sentence_translation")

  lesson                     Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  bookmarks                  UserBookmark[]

  @@index([lessonId])
  @@index([word])
  @@map("vocabulary_items")
}

model Exercise {
  id            String       @id @default(uuid())
  lessonId      String       @map("lesson_id")
  type          ExerciseType
  promptDe      String       @map("prompt_de")
  instructions  Json?        // { "bn": "...", "en": "..." }
  content       Json         // Passage, audio URL, prompts, gaps
  correctAnswer String?      @map("correct_answer")
  sequenceOrder Int          @map("sequence_order")

  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("exercises")
}

model QuizQuestion {
  id                   String        @id @default(uuid())
  lessonId             String        @map("lesson_id")
  questionDe           String        @map("question_de")
  questionTranslation  Json?         @map("question_translation")
  explanationDe        String?       @map("explanation_de")
  explanationTranslation Json?       @map("explanation_translation")
  sequenceOrder        Int           @map("sequence_order")

  lesson               Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options              QuizOption[]
  answers              QuizAnswer[]

  @@index([lessonId])
  @@map("quiz_questions")
}

model QuizOption {
  id                String       @id @default(uuid())
  questionId        String       @map("question_id")
  optionTextDe      String       @map("option_text_de")
  optionTranslation Json?        @map("option_translation")
  isCorrect         Boolean      @map("is_correct")
  sequenceOrder     Int          @map("sequence_order")

  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  lessonId        String       @map("lesson_id")
  totalQuestions  Int          @map("total_questions")
  correctAnswers  Int          @map("correct_answers")
  scorePercentage Int          @map("score_percentage")
  passed          Boolean
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         QuizAnswer[]

  @@index([userId])
  @@index([lessonId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String       @id @default(uuid())
  attemptId        String       @map("attempt_id")
  questionId       String       @map("question_id")
  selectedOptionId String?      @map("selected_option_id")
  isCorrect        Boolean      @map("is_correct")

  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("quiz_answers")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  lessonId        String    @map("lesson_id")
  isCompleted     Boolean   @default(false) @map("is_completed")
  scorePercentage Int?      @map("score_percentage")
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model UserBookmark {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  lessonId     String?         @map("lesson_id")
  vocabularyId String?         @map("vocabulary_id")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary   VocabularyItem? @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@map("user_bookmarks")
}

// -----------------------------------------------------------------------------
// Job Search & Application Tracker Entities (Phase 4)
// -----------------------------------------------------------------------------

enum JobApplicationStatus {
  SAVED
  PLANNED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobListing {
  id                  String               @id @default(uuid())
  externalId          String?              @map("external_id")
  source              String               @default("BUNDESAGENTUR") // BUNDESAGENTUR, DIRECT_EMPLOYER, INTERNAL
  title               String
  employer            String
  city                String
  postalCode          String?              @map("postal_code")
  state               String?
  country             String               @default("Deutschland")
  category            String               // e.g., "Healthcare / Nursing", "IT & Software", "Mechatronics"
  stipendYear1        String?              @map("stipend_year_1") // e.g. "€1,190 / month"
  stipendYear1Cents   Int?                 @map("stipend_year_1_cents") // exact cents e.g. 119000
  requiredGermanLevel CefrLevel?           @default(B1) @map("required_german_level")
  description         String
  requirements        Json?                // Array of string requirements
  benefits            Json?                // Array of strings e.g. ["Housing Support", "Staff Meals"]
  externalUrl         String?              @map("external_url")
  contactEmail        String?              @map("contact_email")
  contactPhone        String?              @map("contact_phone")
  publishedAt         DateTime             @default(now()) @map("published_at")
  expiresAt           DateTime?            @map("expires_at")
  isActive            Boolean              @default(true) @map("is_active")
  metadata            Json?                // Raw Bundesagentur response payload for diagnostics
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  savedBy             SavedJob[]
  applications        JobApplication[]

  @@unique([source, externalId])
  @@index([city])
  @@index([category])
  @@index([requiredGermanLevel])
  @@index([publishedAt])
  @@map("job_listings")
}

model SavedJob {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  jobListingId String      @map("job_listing_id")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobListingId])
  @@index([userId])
  @@map("saved_jobs")
}

model JobApplication {
  id                 String                     @id @default(uuid())
  userId             String                     @map("user_id")
  jobListingId       String?                    @map("job_listing_id")
  customCompany      String?                    @map("custom_company") // For manually tracked off-portal jobs
  customRole         String?                    @map("custom_role")
  city               String?
  status             JobApplicationStatus       @default(APPLIED)
  appliedAt          DateTime?                  @default(now()) @map("applied_at")
  interviewDate      DateTime?                  @map("interview_date")
  contactPerson      String?                    @map("contact_person")
  contactEmail       String?                    @map("contact_email")
  salaryOfferCents   Int?                       @map("salary_offer_cents")
  notes              String?
  nextFollowUpDate   DateTime?                  @map("next_follow_up_date")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                JobListing?                @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  statusHistory      ApplicationStatusHistory[]

  @@index([userId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String               @id @default(uuid())
  applicationId String               @map("application_id")
  fromStatus    JobApplicationStatus? @map("from_status")
  toStatus      JobApplicationStatus @map("to_status")
  notes         String?
  changedAt     DateTime             @default(now()) @map("changed_at")

  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

model JobSyncLog {
  id             String    @id @default(uuid())
  source         String    @default("BUNDESAGENTUR")
  queryTerm      String?   @map("query_term")
  location       String?
  recordsFetched Int       @map("records_fetched")
  recordsSaved   Int       @map("records_saved")
  status         String    // "SUCCESS", "FAILED", "CACHED"
  errorMessage   String?   @map("error_message")
  durationMs     Int       @map("duration_ms")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("job_sync_logs")
}

