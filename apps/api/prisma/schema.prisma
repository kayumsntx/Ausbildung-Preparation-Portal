// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  STUDENT
  INSTRUCTOR
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ExerciseType {
  READING
  LISTENING
  WRITING
  FILL_IN_BLANK
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String                   @map("password_hash")
  status                  AccountStatus            @default(ACTIVE)
  emailVerified           Boolean                  @default(false) @map("email_verified")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")

  profile                 UserProfile?
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  notificationPreference  NotificationPreference?
  quizAttempts            QuizAttempt[]
  lessonProgress          LessonProgress[]
  bookmarks               UserBookmark[]
  savedJobs               SavedJob[]
  jobApplications         JobApplication[]
  courseEnrollments       CourseEnrollment[]
  certificates            Certificate[]
  orders                  Order[]
  instructorProfile       Instructor?
  cvVersions              CvVersion[]
  coverLetters            CoverLetter[]
  userDocuments           UserDocument[]
  checklists              ApplicationChecklist[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleType   @unique
  description String?

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  firstName             String?  @map("first_name")
  lastName              String?  @map("last_name")
  preferredLanguage     String   @default("en") @map("preferred_language")
  targetAusbildungField String?  @map("target_ausbildung_field")
  phoneNumber           String?  @map("phone_number")
  avatarUrl             String?  @map("avatar_url")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  clientIp   String?  @map("client_ip")
  userAgent  String?  @map("user_agent")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  jobAlerts          Boolean  @default(true) @map("job_alerts")
  speakingInvites    Boolean  @default(true) @map("speaking_invites")
  marketing          Boolean  @default(false)
  updatedAt          DateTime @updatedAt @map("updated_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// German Learning Curriculum Entities (Phase 3)
// -----------------------------------------------------------------------------

model LearningLevel {
  id            String          @id @default(uuid())
  code          CefrLevel       @unique
  title         String
  description   String?
  sequenceOrder Int             @map("sequence_order")

  modules       LearningModule[]

  @@map("learning_levels")
}

model LearningModule {
  id            String        @id @default(uuid())
  levelId       String        @map("level_id")
  title         String
  description   String?
  sequenceOrder Int           @map("sequence_order")

  level         LearningLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons       Lesson[]

  @@index([levelId])
  @@map("learning_modules")
}

model Lesson {
  id               String               @id @default(uuid())
  moduleId         String               @map("module_id")
  slug             String               @unique
  titleDe          String               @map("title_de")
  grammarNotesDe   String?              @map("grammar_notes_de")
  estimatedMinutes Int                  @default(15) @map("estimated_minutes")
  sequenceOrder    Int                  @map("sequence_order")
  coinReward       Int                  @default(10) @map("coin_reward")

  module           LearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  translations     LessonTranslation[]
  vocabulary       VocabularyItem[]
  exercises        Exercise[]
  quizQuestions    QuizQuestion[]
  progress         LessonProgress[]
  bookmarks        UserBookmark[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonTranslation {
  id            String   @id @default(uuid())
  lessonId      String   @map("lesson_id")
  languageCode  String   @map("language_code") // "bn", "en", "de"
  title         String
  summary       String?
  grammarNotes  String?  @map("grammar_notes") // Bengali/English explanation of German grammar rule
  content       Json?

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, languageCode])
  @@map("lesson_translations")
}

model VocabularyItem {
  id                         String         @id @default(uuid())
  lessonId                   String?        @map("lesson_id")
  word                       String
  article                    String?        // "der", "die", "das", or null
  pluralForm                 String?        @map("plural_form")
  ipaPronunciation           String?        @map("ipa_pronunciation")
  audioUrl                   String?        @map("audio_url")
  partOfSpeech               String?        @map("part_of_speech")
  translations               Json           // { "bn": "...", "en": "..." }
  exampleSentenceDe          String?        @map("example_sentence_de")
  exampleSentenceTranslation Json?          @map("example_sentence_translation")

  lesson                     Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  bookmarks                  UserBookmark[]

  @@index([lessonId])
  @@index([word])
  @@map("vocabulary_items")
}

model Exercise {
  id            String       @id @default(uuid())
  lessonId      String       @map("lesson_id")
  type          ExerciseType
  promptDe      String       @map("prompt_de")
  instructions  Json?        // { "bn": "...", "en": "..." }
  content       Json         // Passage, audio URL, prompts, gaps
  correctAnswer String?      @map("correct_answer")
  sequenceOrder Int          @map("sequence_order")

  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("exercises")
}

model QuizQuestion {
  id                   String        @id @default(uuid())
  lessonId             String        @map("lesson_id")
  questionDe           String        @map("question_de")
  questionTranslation  Json?         @map("question_translation")
  explanationDe        String?       @map("explanation_de")
  explanationTranslation Json?       @map("explanation_translation")
  sequenceOrder        Int           @map("sequence_order")

  lesson               Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options              QuizOption[]
  answers              QuizAnswer[]

  @@index([lessonId])
  @@map("quiz_questions")
}

model QuizOption {
  id                String       @id @default(uuid())
  questionId        String       @map("question_id")
  optionTextDe      String       @map("option_text_de")
  optionTranslation Json?        @map("option_translation")
  isCorrect         Boolean      @map("is_correct")
  sequenceOrder     Int          @map("sequence_order")

  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  lessonId        String       @map("lesson_id")
  totalQuestions  Int          @map("total_questions")
  correctAnswers  Int          @map("correct_answers")
  scorePercentage Int          @map("score_percentage")
  passed          Boolean
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         QuizAnswer[]

  @@index([userId])
  @@index([lessonId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String       @id @default(uuid())
  attemptId        String       @map("attempt_id")
  questionId       String       @map("question_id")
  selectedOptionId String?      @map("selected_option_id")
  isCorrect        Boolean      @map("is_correct")

  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("quiz_answers")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  lessonId        String    @map("lesson_id")
  isCompleted     Boolean   @default(false) @map("is_completed")
  scorePercentage Int?      @map("score_percentage")
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model UserBookmark {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  lessonId     String?         @map("lesson_id")
  vocabularyId String?         @map("vocabulary_id")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary   VocabularyItem? @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId])
  @@map("user_bookmarks")
}

// -----------------------------------------------------------------------------
// Job Search & Application Tracker Entities (Phase 4)
// -----------------------------------------------------------------------------

enum JobApplicationStatus {
  SAVED
  PLANNED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobListing {
  id                  String               @id @default(uuid())
  externalId          String?              @map("external_id")
  source              String               @default("BUNDESAGENTUR") // BUNDESAGENTUR, DIRECT_EMPLOYER, INTERNAL
  title               String
  employer            String
  city                String
  postalCode          String?              @map("postal_code")
  state               String?
  country             String               @default("Deutschland")
  category            String               // e.g., "Healthcare / Nursing", "IT & Software", "Mechatronics"
  stipendYear1        String?              @map("stipend_year_1") // e.g. "€1,190 / month"
  stipendYear1Cents   Int?                 @map("stipend_year_1_cents") // exact cents e.g. 119000
  requiredGermanLevel CefrLevel?           @default(B1) @map("required_german_level")
  description         String
  requirements        Json?                // Array of string requirements
  benefits            Json?                // Array of strings e.g. ["Housing Support", "Staff Meals"]
  externalUrl         String?              @map("external_url")
  contactEmail        String?              @map("contact_email")
  contactPhone        String?              @map("contact_phone")
  publishedAt         DateTime             @default(now()) @map("published_at")
  expiresAt           DateTime?            @map("expires_at")
  isActive            Boolean              @default(true) @map("is_active")
  metadata            Json?                // Raw Bundesagentur response payload for diagnostics
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  savedBy             SavedJob[]
  applications        JobApplication[]

  @@unique([source, externalId])
  @@index([city])
  @@index([category])
  @@index([requiredGermanLevel])
  @@index([publishedAt])
  @@map("job_listings")
}

model SavedJob {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  jobListingId String      @map("job_listing_id")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobListingId])
  @@index([userId])
  @@map("saved_jobs")
}

model JobApplication {
  id                 String                     @id @default(uuid())
  userId             String                     @map("user_id")
  jobListingId       String?                    @map("job_listing_id")
  customCompany      String?                    @map("custom_company") // For manually tracked off-portal jobs
  customRole         String?                    @map("custom_role")
  city               String?
  status             JobApplicationStatus       @default(APPLIED)
  appliedAt          DateTime?                  @default(now()) @map("applied_at")
  interviewDate      DateTime?                  @map("interview_date")
  contactPerson      String?                    @map("contact_person")
  contactEmail       String?                    @map("contact_email")
  salaryOfferCents   Int?                       @map("salary_offer_cents")
  notes              String?
  nextFollowUpDate   DateTime?                  @map("next_follow_up_date")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                JobListing?                @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  statusHistory      ApplicationStatusHistory[]

  @@index([userId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String               @id @default(uuid())
  applicationId String               @map("application_id")
  fromStatus    JobApplicationStatus? @map("from_status")
  toStatus      JobApplicationStatus @map("to_status")
  notes         String?
  changedAt     DateTime             @default(now()) @map("changed_at")

  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

model JobSyncLog {
  id             String    @id @default(uuid())
  source         String    @default("BUNDESAGENTUR")
  queryTerm      String?   @map("query_term")
  location       String?
  recordsFetched Int       @map("records_fetched")
  recordsSaved   Int       @map("records_saved")
  status         String    // "SUCCESS", "FAILED", "CACHED"
  errorMessage   String?   @map("error_message")
  durationMs     Int       @map("duration_ms")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("job_sync_logs")
}

// -----------------------------------------------------------------------------
// LMS Courses & Paid Educational Programs (Phase 5)
// -----------------------------------------------------------------------------

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  COINS
  FREE
}

model Instructor {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  name      String
  title     String   // e.g. "Goethe-Certified German Educator"
  bio       String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses   Course[]

  @@map("instructors")
}

model Course {
  id            String             @id @default(uuid())
  slug          String             @unique
  title         String
  level         String             // e.g. "A1 Beginner", "B2 Specialized", "B1–B2"
  category      String             // e.g. "Healthcare Terminology", "IT & Engineering", "General German"
  badge         String?            // e.g. "Popular Free Course", "High Employment Impact"
  description   String
  instructorId  String             @map("instructor_id")
  durationHours Int                @default(10) @map("duration_hours")
  isFree        Boolean            @default(true) @map("is_free")
  priceCents    Int                @default(0) @map("price_cents") // EUR in exact cents, e.g. 2900 = €29.00
  coinPrice     Int                @default(0) @map("coin_price")  // e.g. 350 Coins
  isPublished   Boolean            @default(true) @map("is_published")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  instructor    Instructor         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  modules       CourseModule[]
  enrollments   CourseEnrollment[]
  certificates  Certificate[]
  orders        Order[]

  @@index([category])
  @@index([isFree])
  @@map("courses")
}

model CourseModule {
  id            String         @id @default(uuid())
  courseId      String         @map("course_id")
  title         String
  description   String?
  sequenceOrder Int            @map("sequence_order")

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id              String                 @id @default(uuid())
  moduleId        String                 @map("module_id")
  slug            String                 @unique
  title           String
  durationMinutes Int                    @default(15) @map("duration_minutes")
  videoUrl        String?                @map("video_url")
  textContent     String?                @map("text_content")
  resources       Json?                  // Downloadable attachments: [{ title, url, type }]
  sequenceOrder   Int                    @map("sequence_order")
  isFreePreview   Boolean                @default(false) @map("is_free_preview")

  module          CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        CourseLessonProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

model CourseEnrollment {
  id                 String                 @id @default(uuid())
  userId             String                 @map("user_id")
  courseId           String                 @map("course_id")
  status             EnrollmentStatus       @default(ACTIVE)
  progressPercentage Int                    @default(0) @map("progress_percentage")
  enrolledAt         DateTime               @default(now()) @map("enrolled_at")
  completedAt        DateTime?              @map("completed_at")
  lastAccessedAt     DateTime               @default(now()) @map("last_accessed_at")

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress     CourseLessonProgress[]
  certificate        Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_enrollments")
}

model CourseLessonProgress {
  id           String           @id @default(uuid())
  enrollmentId String           @map("enrollment_id")
  lessonId     String           @map("lesson_id")
  isCompleted  Boolean          @default(true) @map("is_completed")
  completedAt  DateTime         @default(now()) @map("completed_at")

  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@map("course_lesson_progress")
}

model Certificate {
  id               String           @id @default(uuid())
  certificateCode  String           @unique @map("certificate_code") // e.g. "CERT-2026-A1B2-789X"
  userId           String           @map("user_id")
  courseId         String           @map("course_id")
  enrollmentId     String           @unique @map("enrollment_id")
  recipientName    String           @map("recipient_name")
  courseTitle      String           @map("course_title")
  issuedAt         DateTime         @default(now()) @map("issued_at")
  verificationHash String           @unique @map("verification_hash") // SHA-256 digital verification hash

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment       CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certificateCode])
  @@map("certificates")
}

model Order {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  courseId              String?       @map("course_id")
  amountCents           Int           @default(0) @map("amount_cents")
  coinsAmount           Int           @default(0) @map("coins_amount")
  paymentMethod         PaymentMethod @map("payment_method")
  status                OrderStatus   @default(PENDING)
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  idempotencyKey        String        @unique @map("idempotency_key")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([idempotencyKey])
  @@map("orders")
}

// -----------------------------------------------------------------------------
// Application Toolkit: CV, Cover Letter & Documents (Phase 6)
// -----------------------------------------------------------------------------

model CvVersion {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String   // e.g. "Pflegefachmann CV - Charité"
  targetVocation String   @map("target_vocation") // e.g. "Pflegefachmann / Pflegefachfrau"
  personalInfo   Json     @map("personal_info")   // { fullName, birthDate, birthPlace, nationality, address, phone, email, photoUrl }
  education      Json     // Array of { startDate, endDate, institution, degree, city, country, description }
  experience     Json     // Array of { startDate, endDate, company, role, city, country, tasks }
  languageSkills Json     @map("language_skills") // Array of { language, level, certificate, description }
  skills         Json     // Array of { category, items }
  interests      Json?    // Array of string hobbies
  locationDate   String?  @map("location_date")   // e.g. "Dhaka, 22. Oktober 2026"
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cv_versions")
}

model CoverLetter {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String   // e.g. "Anschreiben Charité Pflege 2027"
  senderBlock    Json     @map("sender_block")    // { name, address, postalCodeCity, phone, email }
  recipientBlock Json     @map("recipient_block") // { company, contactPerson, department, address, postalCodeCity }
  dateLine       String   @map("date_line")       // e.g. "Dhaka, 22. Oktober 2026"
  subjectLine    String   @map("subject_line")    // e.g. "Bewerbung um einen Ausbildungsplatz..."
  salutation     String   // e.g. "Sehr geehrte Damen und Herren,"
  bodyText       String   @map("body_text")       // Formal paragraphs formatted according to DIN 5008
  signOff        String   @default("Mit freundlichen Grüßen") @map("sign_off")
  enclosures     String?  @default("Anlagen: Lebenslauf, Zeugnisse, Sprachzertifikat B2")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cover_letters")
}

model UserDocument {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String   // e.g. "Goethe B2 Zertifikat"
  category   String   // "LANGUAGE_CERTIFICATE", "SCHOOL_TRANSCRIPT", "PASSPORT", "WORK_REFERENCE", "OTHER"
  fileName   String   @map("file_name")
  fileSize   Int      @map("file_size") // in bytes
  mimeType   String   @map("mime_type") // e.g. "application/pdf"
  fileUrl    String   @map("file_url")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("user_documents")
}

model ApplicationChecklist {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  category      String    // "EMBASSY_VISA", "INTERVIEW_PREP", "DOCUMENT_AUTHENTICATION"
  title         String
  description   String?
  isCompleted   Boolean   @default(false) @map("is_completed")
  dueDate       DateTime? @map("due_date")
  sequenceOrder Int       @default(1) @map("sequence_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("application_checklists")
}



