# ==============================================================================
# Ausbildung Preparation Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment.
# Never commit real credentials or production secrets to source control.

# ------------------------------------------------------------------------------
# 1. Platform & Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ausbildung_portal?schema=public

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Generate cryptographic secrets (e.g., openssl rand -base64 48)
JWT_ACCESS_SECRET=replace_with_super_secret_access_jwt_key_at_least_32_bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_super_secret_refresh_jwt_key_at_least_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# Session Cookie Secret
COOKIE_SECRET=replace_with_super_secret_cookie_signing_key_at_least_32_bytes

# Security Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# ------------------------------------------------------------------------------
# 4. Email Delivery (SMTP / Provider)
# ------------------------------------------------------------------------------
# In development, can use Mailhog/Ethereal or local logger adapter
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developer_user
SMTP_PASSWORD=developer_pass
EMAIL_FROM="Ausbildung Portal <noreply@ausbildungportal.de>"

# ------------------------------------------------------------------------------
# 5. External Job Search API (Bundesagentur für Arbeit / Jobsuche API)
# ------------------------------------------------------------------------------
# Reference: https://jobsuche.api.bund.dev/
JOBSUCHE_API_CLIENT_ID=optional_client_id_if_required
JOBSUCHE_API_KEY=optional_api_key_if_required
JOBSUCHE_API_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobs

# ------------------------------------------------------------------------------
# 6. Object Storage (Private Documents / CVs / Course Assets)
# ------------------------------------------------------------------------------
# S3-compatible storage (e.g. MinIO in local dev, AWS S3 / Cloudflare R2 in prod)
STORAGE_PROVIDER=local # 'local' | 's3' | 'minio' | 'r2'
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=ausbildung-private-docs
STORAGE_ACCESS_KEY=local_minio_access_key
STORAGE_SECRET_KEY=local_minio_secret_key

# ------------------------------------------------------------------------------
# 7. WebRTC Audio/Video Provider (LiveKit Cloud / Twilio / Agora)
# ------------------------------------------------------------------------------
# Recommended provider: LiveKit (supports Web, Flutter, React Native)
WEBRTC_PROVIDER=livekit # 'livekit' | 'mock'
LIVEKIT_API_KEY=dev_livekit_api_key
LIVEKIT_API_SECRET=dev_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud

# ------------------------------------------------------------------------------
# 8. Payment Provider (Stripe / Local Payment Gateway)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe # 'stripe' | 'mock'
STRIPE_SECRET_KEY=sk_test_replace_with_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
STRIPE_PUBLIC_KEY=pk_test_replace_with_public_key

# ------------------------------------------------------------------------------
# 9. Optional Cache & Job Queue (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
